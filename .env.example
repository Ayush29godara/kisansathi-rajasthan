# ==============================================================================
# KisanSathi Rajasthan - Root Environment Configuration Template
# Copy this file to backend/.env and frontend/.env as needed.
# DO NOT commit real secrets to version control.
# ==============================================================================

# Backend Configuration (Backend only - NEVER expose to frontend)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Database & Supabase (Backend only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# Gemini LLM API (Backend only - NEVER expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend Configuration (Publicly safe values only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here
VITE_API_BASE_URL=http://localhost:8000
